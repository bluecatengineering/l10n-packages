{
  "name": "l10n-packages",
  "description": "L10n packages",
  "private": true,
  "scripts": {
    "test": "jest",
    "test-ci": "jest --ci --silent --reporters=jest-junit --coverageReporters=cobertura",
    "lint": "eslint .",
    "lint-ci": "eslint . -f @microsoft/eslint-formatter-sarif -o build/eslint-results.sarif"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bluecatengineering/l10n-packages.git"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@bluecateng/commitlint-config-bluecateng": "^1.0.1",
    "@bluecateng/eslint-config-node": "^6.0.0",
    "@bluecateng/git-check-push": "^1.0.0",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@microsoft/eslint-formatter-sarif": "^3.0.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-terser": "^1.0.0",
    "@swc/core": "^1.16.20",
    "@types/jest": "^30.0.0",
    "babel-plugin-macros": "^3.1.0",
    "eslint": "^9.19.0",
    "jest": "^30.0.4",
    "jest-junit": "^17.0.0",
    "lefthook": "^2.2.2",
    "lerna": "^10.0.0",
    "prettier": "^3.2.5",
    "rollup": "^4.16.4",
    "typescript-eslint": "^8.72.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": "^24.19.0",
    "npm": "^11.17.0"
  },
  "commitlint": {
    "extends": [
      "@bluecateng/commitlint-config-bluecateng"
    ]
  },
  "jest": {
    "automock": true,
    "clearMocks": true,
    "collectCoverage": true,
    "coveragePathIgnorePatterns": [
      "packages/.*/dist/.*"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      }
    },
    "testEnvironmentOptions": {
      "globalsCleanup": "on"
    },
    "transform": {
      "\\.js$": "babel-jest"
    }
  },
  "jest-junit": {
    "suiteName": "unit tests",
    "outputDirectory": "build/test-results",
    "outputName": "unit.xml"
  },
  "allowScripts": {
    "@parcel/watcher": false,
    "@swc/core": false,
    "fsevents": false,
    "lefthook@2.2.2": true,
    "nx": false,
    "unrs-resolver": false
  }
}
